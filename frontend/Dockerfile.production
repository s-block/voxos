FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig.app.json tsconfig.json tsconfig.node.json ./
COPY src/ src/
COPY public/ public/
RUN npm run build

FROM nginx:1.30.6-alpine

RUN apk upgrade --no-cache \
    && chown -R nginx:nginx /var/cache/nginx \
    && sed -i 's@^pid[[:space:]].*;@pid /tmp/nginx.pid;@; /^user[[:space:]]/d' /etc/nginx/nginx.conf

COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/

USER 101:101
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/frontend-health || exit 1
