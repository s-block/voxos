pid /tmp/steel-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  map_hash_bucket_size 128;
  access_log off;
  client_body_temp_path /tmp/steel-nginx/body;
  proxy_temp_path /tmp/steel-nginx/proxy;
  fastcgi_temp_path /tmp/steel-nginx/fastcgi;
  uwsgi_temp_path /tmp/steel-nginx/uwsgi;
  scgi_temp_path /tmp/steel-nginx/scgi;
  map $http_authorization $authorized { default 0; "Bearer __TOKEN__" 1; }
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 3000;
    location = /health { proxy_pass http://127.0.0.1:3001/v1/health; }
    location / {
      if ($authorized = 0) { return 401; }
      proxy_pass http://127.0.0.1:3001;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
      proxy_buffering off;
    }
  }
  server {
    listen 9223;
    location / {
      if ($authorized = 0) { return 401; }
      proxy_pass http://127.0.0.1:9222;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
      proxy_buffering off;
    }
  }
}
