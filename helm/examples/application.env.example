ENVIRONMENT=production
API_PUBLIC_BASE_URL=https://app.example.com
API_CORS_ALLOW_ORIGINS=["https://app.example.com"]
API_DOCS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_GOOGLE_IOS_CLIENT_ID=
FIREBASE_GOOGLE_SERVER_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=app.example.com
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_CHECK_REVOKED=true
# Generate once with: openssl rand -base64 32
# Preserve this key with encrypted off-cluster backups; do not regenerate on deploy.
SECRET_ENCRYPTION_BACKEND=local_aes_gcm
LOCAL_SECRET_ENCRYPTION_KEY=
# Generate independent values with: openssl rand -hex 32
VOICE_ROUTE_SIGNING_SECRET=
MCP_OAUTH_STATE_SIGNING_SECRET=
VOICE_AGENT_NAME=voxos-voice-agent
VOICE_LIVEKIT_ENDPOINT_POLICY=public_wss
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_PATH=/var/lib/voxos/attachments
