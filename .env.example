# Use a reserved static ngrok URL for consistent external webhook and WSS
# endpoints. `make ngrok` reads NGROK_URL; the API reads API_PUBLIC_BASE_URL.
NGROK_URL=https://replace-with-your-static-ngrok-url.ngrok.app
API_PUBLIC_BASE_URL=https://replace-with-your-static-ngrok-url.ngrok.app
# Optional local Flightradar24 MCP container (`make mcp-stack-up`).
FR24_API_KEY=replace-with-your-flightradar24-api-key
FR24_MCP_PORT=8181
# Stateless Monzo MCP container endpoint bearer. Monzo OAuth client details and
# user tokens are entered and stored in VoxOS, never mounted into this container.
MONZO_MCP_HOST_ENDPOINT_TOKEN_FILE=/absolute/path/to/monzo-mcp/monzo-mcp-endpoint-token
MONZO_MCP_UID=10001
MONZO_MCP_GID=10001
# Exact deployment-owned local/private endpoints. Root Docker Compose uses this
# registry for its MCP service names. Host-mode development may add exact
# localhost or 127.0.0.1 endpoints; containers should use Compose service DNS.
OUTBOUND_TRUSTED_ENDPOINTS_JSON=[{"purpose":"mcp","kind":"local_container","url":"http://flightradar24-mcp:8000/mcp"},{"purpose":"mcp","kind":"local_container","url":"http://monzo-mcp:8000/mcp"}]
# Compose always installs the two entries above. Add exact local text-provider,
# host.docker.internal, localhost, or same-instance sidecar URLs here.
OUTBOUND_ADDITIONAL_TRUSTED_ENDPOINTS_JSON=[]
# Generate separate tokens with `openssl rand -hex 32` for local browser services.
BROWSER_AGENT_SERVICE_TOKEN=
STEEL_SERVICE_TOKEN=
# Standalone API runs use the same token as BROWSER_AGENT_SERVICE_TOKEN.
BROWSER_ACCOUNTS_STAGEHAND_SERVICE_TOKEN=
API_DOCS_ENABLED=true
# Optional error monitoring; use this installation's backend project DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.01
# SENTRY_RELEASE=sha-0123456 (defaults to DEPLOYMENT_REVISION when set)
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=20
API_MAX_IN_FLIGHT=64
API_MAX_USER_IN_FLIGHT=4
# Enable revocation checks after configuring a Firebase user-read identity.
FIREBASE_AUTH_CHECK_REVOKED=false
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=local-firebase-project
# Optional release identifier exposed in API and chart frontend health headers.
# DEPLOYMENT_REVISION=sha-0123456
FIREBASE_API_KEY=replace-with-firebase-public-api-key
FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
FIREBASE_ANDROID_APP_ID=replace-with-firebase-android-app-id
FIREBASE_IOS_APP_ID=replace-with-firebase-ios-app-id
FIREBASE_WEB_APP_ID=replace-with-firebase-web-app-id
FIREBASE_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-oauth-client-id
FIREBASE_GOOGLE_SERVER_CLIENT_ID=replace-with-google-web-oauth-client-id
FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
# Private normalized chat-image storage. Local Compose shares this path between
# the API and durable run worker; deployed environments use the private S3 bucket.
ATTACHMENT_STORAGE_BACKEND=local
CHAT_IMAGE_INPUT_ENABLED=true
ATTACHMENT_LOCAL_PATH=.voxos/attachments
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_PREFIX=chat-images
ATTACHMENT_S3_REGION=eu-west-2
ATTACHMENT_MAX_SOURCE_BYTES=26214400
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_TURN_BYTES=20971520
ATTACHMENT_MAX_IMAGES_PER_TURN=4
ATTACHMENT_MAX_PIXELS=20000000
ATTACHMENT_MAX_DIMENSION=4096
ATTACHMENT_THUMBNAIL_DIMENSION=512
ATTACHMENT_STAGING_TTL_SECONDS=86400
ATTACHMENT_MAX_DELETION_ATTEMPTS=5
ATTACHMENT_DELETION_RETRY_INTERVAL_SECONDS=60
ATTACHMENT_MAX_HISTORY_IMAGES=12
ATTACHMENT_MAX_HISTORY_BYTES=41943040
LOGODEV_PUBLISHABLE_KEY=replace-with-logo-dev-publishable-key
# Codex Cloud uses each user's ChatGPT subscription through an encrypted
# auth.json and starts a short-lived runner container for every CLI operation.
# Run `make codex-runner-build` once and `make worker-codex` alongside the API.
CODEX_CLOUD_ENABLED=true
CODEX_CLOUD_DOCKER_EXECUTABLE=docker
CODEX_CLOUD_RUNNER_IMAGE=voxos-codex-runner:0.148.0
CODEX_CLOUD_WORKER_ID=local-codex-cloud-worker
CODEX_CLOUD_MAX_CONCURRENCY=2
CODEX_CLOUD_CLAIM_BATCH_SIZE=2
CODEX_CLOUD_POLL_INTERVAL_SECONDS=2
CODEX_CLOUD_REMOTE_POLL_INTERVAL_SECONDS=10
CODEX_CLOUD_LOGIN_TIMEOUT_SECONDS=900
CODEX_CLOUD_COMMAND_TIMEOUT_SECONDS=120
CODEX_CLOUD_TASK_TRACKING_TIMEOUT_SECONDS=7200
CODEX_CLOUD_LEASE_TIMEOUT_SECONDS=180
CODEX_CLOUD_HEARTBEAT_INTERVAL_SECONDS=20
CODEX_CLOUD_RETRY_DELAY_SECONDS=30
CODEX_CLOUD_SHUTDOWN_GRACE_SECONDS=30
CODEX_CLOUD_MEMORY_LIMIT=512m
CODEX_CLOUD_CPU_LIMIT=1
CODEX_CLOUD_PIDS_LIMIT=128
CODEX_CLOUD_MAX_OUTPUT_BYTES=1048576
PLATFORM_OPENAI_API_KEY=replace-with-platform-openai-api-key
VOICE_AGENT_NAME=voxos-voice-agent
VOICE_WORKER_POLL_INTERVAL_SECONDS=0.25
VOICE_WORKER_START_TIMEOUT_SECONDS=15
VOICE_WORKER_SETTINGS_RESOLUTION_TIMEOUT_SECONDS=10
VOICE_WORKER_START_CONCURRENCY=8
VOICE_WORKER_LEASE_RENEWAL_CONCURRENCY=16
VOICE_WORKER_DEMAND_TTL_SECONDS=60
VOICE_WORKER_IDLE_TTL_SECONDS=60
VOICE_WORKER_IDLE_PROCESSES=0
VOICE_WARM_USER_WORKERS=true
VOICE_WORKER_LEASE_TTL_SECONDS=15
VOICE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=10
VOICE_WORKER_MAX_ACTIVE_PROJECTS=100
VOICE_WORKER_MAX_ACTIVE_PROJECTS_PER_SUPERVISOR=16
VOICE_WORKER_MAX_ACTIVE_PROJECTS_PER_TENANT=2
VOICE_WORKER_MAX_CALLS_PER_PROJECT=32
VOICE_WORKER_DEMAND_RETENTION_SECONDS=86400
VOICE_WORKER_MAINTENANCE_INTERVAL_SECONDS=60
# Local/self-hosted ws or private endpoints require this explicit trust policy.
# Deployed environments should keep the default public_wss policy.
VOICE_LIVEKIT_ENDPOINT_POLICY=trusted_private
DB_NAME=voxos
DB_USER=voxos
DB_PASSWORD=voxos
POSTGRES_ADMIN_USER=voxos_admin
POSTGRES_ADMIN_PASSWORD=voxos_admin
DB_HOST=localhost
DB_PORT=55432
# Local Docker uses the database driver's configured/default transport. Cloud
# Run overrides this with verify-full and the container CA bundle.
DATABASE_TLS_MODE=driver-default
# DATABASE_TLS_CA_FILE=/absolute/path/to/ca-certificates.crt
VOXOS_DB_HOST_PORT=55432
VOICE_ROUTE_SIGNING_SECRET=replace-with-long-random-route-signing-secret
MCP_OAUTH_STATE_SIGNING_SECRET=replace-with-long-random-mcp-oauth-state-signing-secret
MCP_CREDENTIAL_DELEGATION_SIGNING_SECRET=replace-with-a-separate-long-random-mcp-delegation-signing-secret
MCP_CREDENTIAL_DELEGATION_TTL_SECONDS=60
SECRET_ENCRYPTION_BACKEND=local_aes_gcm
LOCAL_SECRET_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# For deployed KMS mode:
# SECRET_ENCRYPTION_BACKEND=aws_kms_envelope
# AWS_KMS_KEY_ID=alias/voxos-user-credentials
# AWS_REGION=eu-west-2
# Optional local KMS-compatible endpoint, for example LocalStack:
# AWS_KMS_ENDPOINT_URL=http://localhost:4566
# Or use Google Cloud KMS with Application Default Credentials:
# SECRET_ENCRYPTION_BACKEND=gcp_kms_envelope
# GCP_KMS_KEY_ID=projects/your-project/locations/europe-west2/keyRings/voxos-vault/cryptoKeys/user-secrets
