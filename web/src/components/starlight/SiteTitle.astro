---
import Logo from "../site/Logo.astro";
---

<a href="/" class="site-title" aria-label="Voxos Docs home">
  <Logo id="docs-header" />
  <span class="section">Docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .section {
    padding: 0.15rem 0.55rem;
    border: 1.5px solid var(--vx-ink);
    border-radius: 999px;
    background: var(--vx-tint-mint);
    color: var(--vx-ink);
    font-size: 0.8rem;
    font-weight: 700;
    transform: rotate(-3deg);
  }
</style>
