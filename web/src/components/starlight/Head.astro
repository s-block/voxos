---
import Default from "@astrojs/starlight/components/Head.astro";
import {
  docPageNodes,
  graph,
  organizationNode,
  serializeJsonLd,
  softwareNode,
  websiteNode,
} from "../../seo/structured-data";
import { configuredSite } from "../../site-url";
import Fonts from "../site/Fonts.astro";

const { entry } = Astro.locals.starlightRoute;
const siteUrl = configuredSite(Astro.site);
const url = new URL(Astro.url.pathname, siteUrl);
const image = new URL(`/og/${entry.id}.png`, siteUrl);
// Pages live under /docs/ or /guides/; each section's home page has no section crumb.
const sectionId = entry.id.split("/")[0] ?? entry.id;
const section =
  entry.id === sectionId
    ? undefined
    : { name: sectionId === "guides" ? "Guides" : "Docs", url: new URL(`/${sectionId}/`, siteUrl) };
const structuredData = graph(
  websiteNode(siteUrl),
  organizationNode(siteUrl),
  softwareNode(siteUrl),
  ...docPageNodes({
    title: entry.data.title,
    description: entry.data.description ?? "",
    url,
    image,
    lastUpdated: entry.data.lastUpdated instanceof Date ? entry.data.lastUpdated : undefined,
    section,
  }),
);
---

<Default />
<Fonts />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={entry.data.title} />
<meta name="twitter:image" content={image.href} />
<meta name="theme-color" content="#ffffff" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="text/markdown" href={new URL(`/${entry.id}.md`, siteUrl).href} />
<script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
