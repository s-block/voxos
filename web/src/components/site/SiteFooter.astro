---
import { githubUrls, repositoryUrl, site } from "../../site.config";
import AnalyticsSettings from "./AnalyticsSettings.astro";
import Logo from "./Logo.astro";

interface FooterLink {
  readonly href: string;
  readonly label: string;
  /** Analytics event sent when the link is followed. */
  readonly event?: string;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/#channels", label: "Voice, calls and texts" },
      { href: "/#features", label: "Features" },
      { href: "/#integrations", label: "Integrations" },
      { href: "/#faq", label: "FAQ" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/docs/quick-start/", label: "Quick Start" },
      { href: "/guides/", label: "Guides" },
      { href: "/docs/phone-integrations/", label: "Phone integrations" },
      { href: "/docs/mcp-and-tools/", label: "MCP and tools" },
      { href: "/docs/skills/", label: "Example skills" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: repositoryUrl, label: "GitHub", event: "github_click" },
      { href: githubUrls.releases, label: "Releases" },
      { href: githubUrls.issues, label: "Issues" },
      { href: "/docs/security/", label: "Security" },
      { href: githubUrls.license, label: `${site.license} License` },
    ],
  },
];
---

<footer class="site-footer">
  <div class="vx-container grid">
    <div class="about">
      <a href="/" aria-label="Voxos home" class="home"><Logo id="site-footer" /></a>
      <p>Open-source voice AI agents that answer the phone, text back and get things done.</p>
      <p class="aside">Made with coffee and a worrying number of webhooks.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} data-analytics-event={link.event}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="vx-container base">
    <a href="/privacy/">Privacy</a>
    <AnalyticsSettings />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 4rem 0 3rem;
    border-top: 2px solid var(--vx-ink);
    background: var(--vx-paper-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2.5rem;
  }

  .home {
    display: inline-block;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .about p {
    max-width: 22rem;
    color: var(--vx-ink-soft);
  }

  .about .aside {
    margin-top: 1rem;
    font-family: var(--vx-font-hand);
    font-size: 1.35rem;
    color: var(--vx-violet-deep);
  }

  h2 {
    margin-bottom: 0.9rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vx-ink-muted);
  }

  ul {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
    font-weight: 400;
  }

  ul a:hover {
    color: var(--vx-violet);
    text-decoration: underline;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--vx-line-strong);
    font-size: 0.9rem;
    color: var(--vx-ink-muted);
  }

  .base a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
