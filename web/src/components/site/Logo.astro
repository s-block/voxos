---
import { inlineSvg, voxosMarkSvg } from "../../brand";

interface Props {
  /** Prefix for the SVG's internal ids; must be unique on the page. */
  id: string;
  size?: "sm" | "md";
}

const { id, size = "md" } = Astro.props;
---

<span class="logo" data-size={size} aria-hidden="true">
  <span class="mark" set:html={inlineSvg(voxosMarkSvg, `${id}-mark`)} />
  <span class="wordmark"><span>Vox</span><span class="os">OS</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--vx-font-display);
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--vx-ink);
  }

  .logo[data-size="sm"] {
    font-size: 1.2rem;
  }

  .mark {
    display: block;
    width: 1.6em;
    height: 1.6em;
    flex: none;
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .os {
    background: linear-gradient(110deg, #18e9d0 0%, #5d63ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
